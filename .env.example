#Secretary Core — прокси расшифровки
SECRETARY_PROXY_BASE_URL=
SECRETARY_PROXY_API_KEY=
SECRETARY_MODEL=
# x-api-key | authorization (уточнить на экземпляре прокси)
SECRETARY_PROXY_AUTH_HEADER=x-api-key

# Лимиты аудио
SECRETARY_MAX_AUDIO_BYTES=10485760
SECRETARY_MAX_SOURCE_BYTES=1073741824
SECRETARY_MAX_DURATION_SECONDS=43200

# Сегментация
SECRETARY_SEGMENT_SECONDS=900
SECRETARY_OVERLAP_SECONDS=4
SECRETARY_MIN_SEGMENT_SECONDS=30

# Транспорт: таймауты и повторы
SECRETARY_REQUEST_TIMEOUT_SECONDS=300
SECRETARY_MAX_ATTEMPTS=4
SECRETARY_BACKOFF_BASE_SECONDS=1.5
SECRETARY_BACKOFF_MAX_SECONDS=30
SECRETARY_RETRY_AFTER_CAP_SECONDS=120

# Хранилище
SECRETARY_DB_PATH=data/secretary.db
SECRETARY_JOBS_DIR=data/jobs
SECRETARY_DISK_BUDGET_BYTES=2147483648
SECRETARY_KEEP_SEGMENT_FILES=false
SECRETARY_STRUCTURE_CHUNK_CHARS=50000

# Воркер (последовательный по умолчанию)
SECRETARY_CONCURRENCY=1
SECRETARY_WORKER_POLL_SECONDS=0.5

# HTTP API
SECRETARY_API_TOKEN=
SECRETARY_ALLOW_LOOPBACK_HTTP=true

# ffmpeg
SECRETARY_FFMPEG_TIMEOUT_SECONDS=180

# ZIP-импорт
SECRETARY_MAX_ZIP_ENTRIES=200
SECRETARY_MAX_ZIP_TOTAL_BYTES=1073741824
SECRETARY_MAX_ZIP_MEMBER_BYTES=268435456
SECRETARY_MAX_ZIP_RATIO=100

# Потоковая загрузка больших файлов по HTTPS/Google Drive
SECRETARY_URL_MAX_BYTES=536870912
SECRETARY_URL_MAX_REDIRECTS=4
SECRETARY_URL_TIMEOUT_SECONDS=120
SECRETARY_URL_MIN_FREE_AFTER_BYTES=536870912

# Видео: отдельная мультимодальная модель (пусто = SECRETARY_MODEL)
SECRETARY_VIDEO_MODEL=
SECRETARY_VIDEO_MAX_SOURCE_BYTES=536870912
SECRETARY_VIDEO_MAX_DURATION_SECONDS=1800
SECRETARY_VIDEO_SEGMENT_SECONDS=120
SECRETARY_VIDEO_MIN_SEGMENT_SECONDS=10
SECRETARY_VIDEO_MAX_SEGMENT_BYTES=10485760
SECRETARY_VIDEO_MAX_WIDTH=960
# false: удалить исходник после успешного анализа
SECRETARY_VIDEO_KEEP_SOURCE=false

# YouTube: только публичные одиночные видео, без live/плейлистов
SECRETARY_YTDLP_PATH=yt-dlp
SECRETARY_YOUTUBE_MAX_DURATION_SECONDS=1800
SECRETARY_YOUTUBE_MAX_BYTES=536870912
SECRETARY_YOUTUBE_TIMEOUT_SECONDS=600

# Утилита examples/proxy_check.py (pass5): live — только с двойным
# подтверждением: эта переменная =1 И флаг --live-yes в команде.
SECRETARY_LIVE_CONFIRM=
